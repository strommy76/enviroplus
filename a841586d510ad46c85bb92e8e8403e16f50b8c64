"""One-use real-rclone check of the review claim that a file error aborts siblings."""
import json
import os
import tempfile
from pathlib import Path
from shared import offsite_replication as rep

# One attempt avoids waiting for retries of a deliberately permanent read error;
# concurrency remains the real service default. No host/daemon env is changed.
os.environ['RCLONE_RETRIES']='1'
os.environ['RCLONE_LOW_LEVEL_RETRIES']='1'
with tempfile.TemporaryDirectory(prefix='backup-batch-isolation-') as directory:
    root=Path(directory)
    source=root/'source'
    source.mkdir()
    bad=source/'a_unreadable.ndjson'
    bad.write_bytes(b'cannot read')
    # More than the native default four transfers: siblings must be scheduled,
    # not just already in flight when the first file fails.
    expected={f'z_good_{i:02}.ndjson':f'observation {i}\n'.encode() for i in range(16)}
    for name,body in expected.items():
        (source/name).write_bytes(body)
    bad.chmod(0)
    try:
        try:
            rep.replicate_tree(source,str(root/'remote'),config_path='/dev/null')
        except rep.ReplicationError as exc:
            result=exc.result
            assert result is not None and not result.verified
