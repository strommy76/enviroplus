[Unit]
Description=Enviro+ Dashboard
After=network-online.target
Wants=network-online.target
# Serial sensors are optional lanes; no UART device binds dashboard lifetime.
OnFailure=stocks_ops_alert@%n.service
# No start limit beyond the systemd default (5 starts / 10 s), which the 30 s
# spacing never reaches: a Tier 1 write failure (e.g. a full disk) ends the
# process, and recovery must resume by itself once the fault clears rather
# than stop the unit for good. Every failed exit alerts through OnFailure.

[Service]
Type=simple
User=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
# Preserve the deployed device-readiness check, not the obsolete guessed sleep.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/i2c-1 ] && [ -e /dev/spidev0.1 ] && exit 0; sleep 1; done; echo "i2c-1 or spidev0.1 never appeared" >&2; exit 1'
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python enviro_dash3.py
Restart=on-failure
# PROVISIONAL inherited spacing: settle from observed recovery time/attempt cost.
RestartSec=30
# Flat restart every 30 s, with no stop limit (the systemd default of 5
# starts / 10 s is never reached at this spacing): collection resumes within
# one interval of the fault clearing. Repeat alerts are throttled by the
# alert service itself (stocks alert_config repage_seconds), not here.

[Install]
WantedBy=multi-user.target
