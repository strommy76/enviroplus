[Unit]
Description=Enviro+ offsite backup (database snapshot + canonical raw tier)
Documentation=file:///home/pistrommy/projects/enviroplus/config/backup.json
# Network-online, not just network: rclone needs a routable path to the remote,
# and starting before that produces a failure that looks like a bad remote.
After=network-online.target
Wants=network-online.target

# The lane this replaced failed silently because nothing surfaced it. Delivery
# uses the host's existing push transport rather than a second alerting stack.
# OnFailure is a [Unit] directive: placed under [Service], systemd parses it,
# logs "Unknown key", discards it, and the unit runs with no alerting at all.
OnFailure=enviro_backup_failure.service

[Service]
Type=oneshot
User=pistrommy
Group=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
Environment=PYTHONPATH=/home/pistrommy/projects
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python scripts/backup_enviro.py

# Off-nominal guard only. A nominal run transfers deltas over an already-synced
# tree and completes in well under a minute; the first full run moved 115.6 MB
# in ~2.5 minutes. This trips on a hung transfer, never on a normal one.
TimeoutStartSec=3600

# The script exits non-zero and writes no manifest when it cannot prove what
# landed. Do not retry into a failing remote -- the timer's next firing is the
# retry, and a failed unit stays visible in systemctl --failed rather than being
# churned away.
Restart=no

# No [Install]: this unit is driven by enviro_backup.timer. Carrying
# WantedBy=multi-user.target would let `systemctl enable enviro_backup.service`
# run a backup at every boot, which is not what a daily timer means.
