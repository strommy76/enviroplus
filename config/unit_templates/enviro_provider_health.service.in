[Unit]
Description=Provider observation freshness
OnFailure=stocks_ops_alert@%n.service

[Service]
Type=oneshot
User=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python -m provider_health
Environment=PYTHONPATH=/home/pistrommy/projects
