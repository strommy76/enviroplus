# ── Paths ─────────────────────────────────────────────────────────────────────
SQLITE_PATH=/home/pi/projects/enviroplus/enviro.db
CONFIG_PATH=/home/pi/projects/enviroplus/dynamic_config.pi5.json

# ── Hardware (Pi-specific) ───────────────────────────────────────────────────
PMS5003_DEVICE=/dev/ttyAMA0

# ── NWS (National Weather Service) ───────────────────────────────────────────
NWS_API_BASE_URL=https://api.weather.gov
NWS_STATIONS=KCOF,KMLB,KXMR,KX21,KVRB
NWS_USER_AGENT=example-enviroplus/1.0 (operator@example.com)
# PROVISIONAL: settle from observed per-station update spacing in retention
NWS_POLL_S=600
NWS_SHUTDOWN_CHECK_S=1
NWS_MAX_OBSERVATION_AGE_S=7200
NWS_COLLECTION_LOOKBACK_S=21600

# ── Ambient Weather ───────────────────────────────────────────────────────────
AW_API_KEY=PLACEHOLDER_AMBIENT_WEATHER_API_KEY
AW_APP_KEY=PLACEHOLDER_AMBIENT_WEATHER_APP_KEY
AW_MAC=PLACEHOLDER_AMBIENT_WEATHER_MAC
# the devices endpoint reports a new lastData each minute
AW_POLL_S=60

# ── AirNow (EPA) ──────────────────────────────────────────────────────────────
AIRNOW_API_KEY=PLACEHOLDER_AIRNOW_API_KEY
AIRNOW_LAT=PLACEHOLDER_LATITUDE
AIRNOW_LON=PLACEHOLDER_LONGITUDE
# PROVISIONAL: miles; the radius that reaches the nearest reporting area
AIRNOW_DISTANCE=50
# PROVISIONAL: AirNow observations are hourly; settle from retained statement spacing
AIRNOW_POLL_S=1800

# ── Hardware notes ───────────────────────────────────────────────────────────
# I2C_BUS=1
# PMS5003_DEVICE=/dev/ttyAMA0          # Pi 3 B+: /dev/ttyAMA0  Pi 5: check /dev/ttyAMA*
# CPU_TEMP_PATH=/sys/class/thermal/thermal_zone0/temp
