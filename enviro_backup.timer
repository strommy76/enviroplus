[Unit]
Description=Daily Enviro+ offsite backup
Documentation=file:///home/pistrommy/projects/enviroplus/config/backup.json

[Timer]
# 09:20 UTC = 05:20 EDT. Chosen to sit clear of the stocks backup lanes (capture
# runs 07:10 UTC) so two rclone jobs never contend for the same remote, and well
# clear of any market-hours activity on this host.
OnCalendar=*-*-* 09:20:00 UTC

# The predecessor to this lane failed for one reason above all others: it was
# never scheduled, so it never ran, so nobody learned it was broken. Persistent
# means a host that was asleep at 09:20 still backs up on wake rather than
# silently skipping the day.
Persistent=true

# Avoids a thundering herd against the remote if other timers share the minute.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
