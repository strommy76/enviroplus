[Unit]
Description=Ambient Weather Poller
After=network-online.target
Wants=network-online.target
# A Tier 1 (raw retention) write failure ends the collector rather than letting
# it derive rows the canonical tier does not hold. Every failed exit alerts
# (systemd 257 triggers OnFailure= on each one, restart or not).
OnFailure=stocks_ops_alert@%n.service

[Service]
Type=simple
User=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
Environment=PYTHONPATH=/home/pistrommy/projects
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python ambient_wx.py
Restart=always
RestartSec=10
# Back off instead of stopping: a fault such as a full disk retries for as long
# as it lasts, from the existing 10 s spacing up to the maximum, so collection
# resumes by itself and the per-failure alerts thin out. The step count runs
# from boot or the last manual start, not per fault: after five automatic
# restarts every later one waits the maximum. The start limit stays
# the systemd default (5 starts / 10 s), which spacing >= 10 s never reaches.
# PROVISIONAL maximum: settle from observed Tier 1 write-failure recovery times.
RestartSteps=5
RestartMaxDelaySec=300

[Install]
WantedBy=multi-user.target
