[Unit]
Description=Daily Enviro+ offsite backup
Documentation=file://@ROOT@/config/backup.json

[Timer]
# Project-configured quiet-hour calendar; no fleet-wide frequency assumption.

# The predecessor to this lane failed for one reason above all others: it was
# never scheduled, so it never ran, so nobody learned it was broken. Persistent
# means a host that was asleep at the configured time still backs up on wake rather than
# silently skipping the day.
Persistent=true

# Timing directives are generated from config/backup.json.

[Install]
WantedBy=timers.target
