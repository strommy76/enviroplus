[Unit]
Description=NWS Weather Poller (configured station set)
After=network-online.target
Wants=network-online.target
# A Tier 1 (raw retention) write failure ends the collector rather than letting
# it derive rows the canonical tier does not hold. Every failed exit alerts
# (systemd 257 triggers OnFailure= on each one, restart or not).
OnFailure=stocks_ops_alert@%n.service

[Service]
Type=simple
User=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
Environment=PYTHONPATH=/home/pistrommy/projects
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python nws_wx.py
Restart=always
RestartSec=10
# Flat restart every 10 s, with no stop limit (the systemd default of 5
# starts / 10 s is never reached at this spacing): collection resumes within
# one interval of the fault clearing. Repeat alerts are throttled by the
# alert service itself (stocks alert_config repage_seconds), not here.

[Install]
WantedBy=multi-user.target
