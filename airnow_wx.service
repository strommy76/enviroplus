[Unit]
Description=AirNow (EPA) Air Quality Poller (provider capture contract)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pistrommy
WorkingDirectory=/home/pistrommy/projects/enviroplus
Environment=PYTHONPATH=/home/pistrommy/projects
ExecStart=/home/pistrommy/.virtualenvs/pimoroni/bin/python provider_collector.py --contract contracts/airnow_current.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
